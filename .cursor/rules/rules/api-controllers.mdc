## URL Routing

In `app/routes/*.py`:
```python
from django.urls import path
from app.controllers import api_controller

urlpatterns = [
    path('items/', api_controller.list_items, name='items_list'),
    path('items/<str:item_uuid>/', api_controller.item_detail, name='item_detail'),
    path('items/<str:item_uuid>/update/', api_controller.item_update, name='item_update'),
    path('items/<str:item_uuid>/delete/', api_controller.item_delete, name='item_delete'),
]
```

## Common Patterns

### File Upload Endpoints
```python
@extend_schema(
    request={
        'multipart/form-data': {
            'type': 'object',
            'properties': {
                'file': {'type': 'string', 'format': 'binary', 'description': 'File to upload'}
            }
        }
    },
    responses={200: Action.generate_schema(MyModel.api_response_schema())},
    description="Upload file",
)
@api_view(["POST"])
@throttle_classes([AnonRateThrottle, UserRateThrottle])
@permission_classes([IsAuthenticated])
def upload_file(request):
    current_user = getattr(request, 'impersonated_user', None) or request.user
    file = request.FILES.get("file")
    
    if not file:
        return ApiHandler.bad_request(["File is required"]).json_response()
    
    return ApiHandler.handle_file_upload(current_user, file).json_response()
```

### Serializer Validation (Optional)
For complex validation, use DRF serializers:
```python
from rest_framework import serializers

class ItemQuerySerializer(serializers.Serializer):
    search = serializers.CharField(required=False)
    status = serializers.ChoiceField(choices=["ACTIVE", "INACTIVE"], required=False)
    date_from = serializers.DateField(required=False)

@api_view(["GET"])
@permission_classes([IsAuthenticated])
def list_items(request):
    current_user = getattr(request, 'impersonated_user', None) or request.user
    
    # Validate query parameters
    serializer = ItemQuerySerializer(data=request.GET)
    if not serializer.is_valid():
        return ApiHandler.bad_request(serializer.errors).json_response()
    
    # Use validated data
    return ApiHandler.list_items(
        current_user, **serializer.validated_data
    ).json_response()
```
