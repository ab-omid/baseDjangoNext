# Core app
APP_SECRET_KEY=change-me
APP_DEBUG=true
APP_ALLOWED_HOSTS=localhost,127.0.0.1
APP_SETTINGS_MODULE=PDNR.settings
APP_BASE_URL=http://127.0.0.1:8000
APP_FRONTEND_URL=http://127.0.0.1:3000

# Static and media
APP_MEDIA_ROOT=storage/media/
APP_MEDIA_URL=/storage/media/
APP_STATIC_ROOT=storage/static/
APP_STATIC_URL=/storage/static/

# Error tracking (Sentry)
APP_ERROR_TRACKING_DSN=
APP_ERROR_TRACKING_ENVIRONMENT=development
APP_ERROR_TRACKING_RELEASE=
APP_ERROR_TRACKING_TRACES_SAMPLE_RATE=0.0
APP_ERROR_TRACKING_PROFILES_SAMPLE_RATE=0.0
APP_ERROR_TRACKING_SEND_PII=false
APP_ERROR_TRACKING_ENABLE_LOGS=false
APP_ERROR_TRACKING_LOG_LEVEL=ERROR

# Database
DB_ENGINE=django.db.backends.postgresql_psycopg2
DB_NAME=pdnr
DB_USER=postgres
DB_PASSWORD=secret
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=pdnr:

# Celery
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_BROKER_URL=redis://REDIS:6379/0
CELERY_RESULT_BACKEND=redis://REDIS:6379/0
WORKER_HASH_PREFIX=local

# Jobs
JOBS_DELETE_TEMPORARY_FILE_MAX_RETRIES=2
JOBS_DELETE_TEMPORARY_FILE_DELAY_TO_RETRY_FAILED_JOBS=2

# OpenAI
OPENAI_API_KEY=
OPEN_AI_MODEL=gpt-4-turbo
OPEN_AI_TRANSCRIPT_MODEL=whisper-1

# Unipile
UNIPILE_INCOMING_REQUESTS_API_KEY=
UNIPILE_API_KEY=
UNIPILE_BASE_URL=https://api1.unipile.com:13111/api/v1/

# SendGrid
SENDGRID_API_KEY=
SENDGRID_DEFAULT_FROM_EMAIL=noreply@pdnr.com
SENDGRID_DEFAULT_FROM_NAME=PDNR

# Throttling
THROTTLING_ENABLED=true
THROTTLING_USER_RATE=1000/minute
THROTTLING_ANON_RATE=100/minute
THROTTLING_ADMIN_RATE=
THROTTLING_PIPELINE_RATE=
